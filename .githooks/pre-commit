#!/bin/sh
# Refresh the 30-day stats table at the top of README.md and stage it.
# Enable once per clone: git config core.hooksPath .githooks
# Never blocks a commit: if ccstats or its data is unavailable, the table is left as is.
cd "$(git rev-parse --show-toplevel)" || exit 0
command -v ccstats >/dev/null 2>&1 || { echo "pre-commit: ccstats not on PATH; README stats not refreshed" >&2; exit 0; }
json=$(ccstats -q report --days 30 --total --json 2>/dev/null) || { echo "pre-commit: ccstats report failed; README stats not refreshed" >&2; exit 0; }

printf '%s' "$json" | python3 -c '
import json, re, sys, datetime
t = json.load(sys.stdin)[0]
h, m = divmod(round((t["claude_s"] + t["agent_s"]) / 60), 60)  # main + subagent time
out = t["tokens"]["main"]["output"] + t["tokens"]["sub"]["output"]
cost, sess, sub, tools = t["cost"]["total"], t["sessions"], t["subagents"], t["tool_calls"]
table = "\n".join([
    "<!-- stats:begin (generated by .githooks/pre-commit; do not edit) -->",
    f"Last 30 days, as of {datetime.date.today().isoformat()}:",
    "",
    "| Claude time | Est. cost | Sessions | Subagents | Tool calls | Output tokens |",
    "|---|---|---|---|---|---|",
    f"| {h}h{m:02d}m | ${cost:,.0f} | {sess:,} | {sub:,} | {tools:,} | {out / 1e6:.1f}M |",
    "<!-- stats:end -->",
])
src = open("README.md").read()
pat = re.compile(r"<!-- stats:begin.*?<!-- stats:end -->", re.S)
if pat.search(src):
    new = pat.sub(lambda _: table, src, count=1)
else:  # first run: insert after the title line
    title, _, rest = src.partition("\n")
    new = f"{title}\n\n{table}\n{rest}"
if new != src:
    open("README.md", "w").write(new)
' && git add README.md
exit 0
